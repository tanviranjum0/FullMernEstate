{
  "name": "tanvirdev-property",
  "version": "2.0.0",
  "private": true,
  "description": "Luxury real-estate discovery and lead-generation platform.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:indexes": "tsx --env-file-if-exists=.env.local scripts/sync-indexes.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed-development.ts",
    "db:migrate-legacy": "tsx --env-file-if-exists=.env.local scripts/migrate-legacy-data.ts",
    "admin:create": "tsx --env-file-if-exists=.env.local scripts/create-admin.ts",
    "media:build-static": "tsx scripts/build-static-media.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/blob": "2.8.1",
    "@vercel/functions": "3.9.11",
    "@vercel/speed-insights": "2.0.0",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "maplibre-gl": "6.13.0",
    "marked": "18.1.0",
    "mongodb": "7.7.0",
    "mongoose": "9.11.1",
    "motion": "14.0.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.1",
    "sanitize-html": "2.18.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
