# -----------------------------------------------------------------------------
# TanvirDev Property — environment variables
# Copy to .env.local for development. See docs/ENVIRONMENT.md for details.
# Never commit real values.
# -----------------------------------------------------------------------------

# --- Required ----------------------------------------------------------------

# MongoDB connection string INCLUDING the database name.
# Local (Docker replica set):
#   mongodb://localhost:27017/tanvirdev_property?replicaSet=rs0&directConnection=true
# Atlas:
#   mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign sessions and hash identifiers (min 32 chars).
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# --- URLs ----------------------------------------------------------------------

# Canonical public origin (no trailing slash). Used for metadata, sitemap and auth.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Auth origin; defaults to NEXT_PUBLIC_SITE_URL.
BETTER_AUTH_URL=

# --- Media -----------------------------------------------------------------------

# "blob" (Vercel Blob) or "local" (development only, files under .data/media).
# Defaults to "blob" when BLOB_READ_WRITE_TOKEN is present.
MEDIA_STORAGE=
# Provided automatically when a Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# --- Email (optional) --------------------------------------------------------------

# Enables lead notifications and password-reset emails. Without these, enquiries are
# still stored and visible in the admin dashboard; password reset is hidden.
RESEND_API_KEY=
# Verified sender, e.g. "TanvirDev Property <hello@yourdomain.com>"
EMAIL_FROM=
# Inbox that receives new-enquiry notifications.
LEAD_NOTIFICATION_EMAIL=

# --- Branding (optional) -------------------------------------------------------------

NEXT_PUBLIC_SITE_NAME=TanvirDev Property
NEXT_PUBLIC_DEFAULT_CURRENCY=BDT
# MapLibre style; defaults to OpenFreeMap "positron" (no API key needed).
NEXT_PUBLIC_MAP_STYLE_URL=

# --- Scripts only ---------------------------------------------------------------------

# Password for `npm run admin:create`; if empty a random one is generated and written to
# .admin-credentials.local (git-ignored).
ADMIN_PASSWORD=
